# Winged Eats · configuration locale
# Copiez ce fichier en « .env » (même dossier) et collez vos clés après le signe =.
# Le fichier .env n'est jamais versionné (voir .gitignore). Redémarrez « npm start » après modification.

# Clé SERVEUR Google : Places API (New).
# Dans Google Cloud : Restrictions d'API → « Places API (New) » uniquement.
GOOGLE_PLACES_API_KEY=

# Clé NAVIGATEUR Google : Maps JavaScript API (fond de carte de l'écran Carte).
# Elle est visible dans le navigateur : restreignez-la à « Maps JavaScript API »
# et aux référents HTTP de votre site (ex. http://localhost:3000/*).
GOOGLE_MAPS_BROWSER_KEY=

# Identifiant de carte (Map ID) pour les repères. DEMO_MAP_ID convient pour les tests ;
# créez le vôtre dans Google Cloud → Google Maps Platform → Gestion des cartes.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Garde-fous de facturation (nombre maximal d'appels Google Places).
GOOGLE_MAX_CALLS_PER_MINUTE=120
GOOGLE_MAX_CALLS_PER_DAY=3000
